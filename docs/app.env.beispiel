# Agora – App-Einstellungen (Vorlage; als app.env speichern, chmod 600)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=agora@example.org
AGORA_GEHEIM=<openssl rand -hex 32>
AGORA_SEITE=https://agora.example.org
AGORA_LIVEKIT_URL=wss://agora.example.org
LIVEKIT_API_HOST=http://127.0.0.1:7880
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>
# Admins (Komma-Liste, nur bestätigte Konten): Meldungen per Mail, Admin-Bereich /admin
AGORA_ADMIN_MAILS=
# Optional: Monitoring von außerhalb 127.0.0.1 (Authorization: Bearer …) und Mindestplatz für /api/gesund?tief=1
# AGORA_METRIKEN_TOKEN=<openssl rand -hex 32>
# AGORA_PLATTE_MIN_GB=2
# Optional: Dateien im Meeting – erlaubte Endungen (Komma-Liste; Vorgabe siehe app/dateien.py) und Virenprüfung über clamd
# AGORA_DATEI_ENDUNGEN=pdf,png,jpg,docx,xlsx,pptx,zip
# AGORA_CLAMAV=127.0.0.1:3310
# Optional: Android-App (TWA, mobil/android/) – SHA-256 des Signatur-Zertifikats für /.well-known/assetlinks.json
# AGORA_ANDROID_SHA256=AB:CD:…
# AGORA_ANDROID_PAKET=dev.slxt.agora.twa
# Optional: Push-Benachrichtigungen – ohne Angabe erzeugt die App den VAPID-Schlüssel selbst (daten/push-vapid.json)
# AGORA_VAPID_PRIVAT=<32 Byte Base64url>
# AGORA_VAPID_SUBJEKT=mailto:agora@example.org
# AGORA_PUSH_DIENSTE=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
