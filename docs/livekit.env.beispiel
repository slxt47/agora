# LiveKit (Vorlage; als livekit.env speichern, chmod 600)
LIVEKIT_KEYS=<key>: <secret>
NODE_IP=<öffentliche IPv4 des Servers>
# Mehrere Knoten (ADR 0007): auf JEDEM Knoten derselbe LIVEKIT_KEYS-Eintrag und dasselbe Redis, eigene NODE_IP und Region
# REDIS_HOST=<private IP des Redis-Servers>:6390
# REDIS_PASSWORD=<openssl rand -hex 24>
# LIVEKIT_REGION=eu-central
